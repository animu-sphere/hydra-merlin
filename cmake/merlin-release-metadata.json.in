{
  "schema": "animu-sphere.hdmerlin.release-metadata",
  "schema_version": 1,
  "project": {
    "name": "hdMerlin",
    "version": "@PROJECT_VERSION@"
  },
  "configuration": {
    "vulkan": @_merlin_metadata_vulkan_enabled@,
    "metal": @_merlin_metadata_metal_enabled@,
    "hydra2": @_merlin_metadata_hydra2_enabled@,
    "hgi_vulkan_bridge": @_merlin_metadata_hgi_vulkan_bridge_enabled@,
    "hgi_metal_bridge": @_merlin_metadata_hgi_metal_bridge_enabled@,
    "materialx": @_merlin_metadata_materialx_enabled@,
    "viewport": @_merlin_metadata_viewport_enabled@
  },
  "requirements": {
    "cmake": {
      "minimum": "3.24"
    },
    "cpp": {
      "standard": 20
    },
    "vulkan": {
      "minimum": "@MERLIN_VULKAN_MIN_VERSION@",
      "detected": @_merlin_metadata_vulkan_version@,
      "sdk_detected": @_merlin_metadata_vulkan_sdk_version@
    },
    "slang": {
      "required_series": "@MERLIN_SLANG_REQUIRED_SERIES@",
      "detected": @_merlin_metadata_slang_version@,
      "shader_abi_version": @MERLIN_SHADER_ABI_VERSION@,
      "artifact_schema_version": @_merlin_metadata_shader_artifact_schema@
    },
    "materialx": {
      "minimum": "@MERLIN_MATERIALX_MIN_VERSION@",
      "detected": @_merlin_metadata_materialx_version@,
      "genslang_revision": "@MERLIN_MATERIALX_GENSLANG_REVISION@"
    },
    "openusd": {
      "validated": "@MERLIN_OPENUSD_VALIDATED_VERSION@",
      "detected": @_merlin_metadata_openusd_version@
    },
    "glfw": {
      "minimum": "@MERLIN_GLFW_MIN_VERSION@",
      "fallback_commit": "@MERLIN_GLFW_PINNED_COMMIT@"
    },
    "imgui": {
      "version": "@MERLIN_IMGUI_VERSION@",
      "commit": "@MERLIN_IMGUI_PINNED_COMMIT@"
    },
    "native_file_dialog_extended": {
      "version": "@MERLIN_NFD_VERSION@",
      "commit": "@MERLIN_NFD_PINNED_COMMIT@"
    }
  },
  "packaging": {
    "cmake_package": "Merlin",
    "exported_targets": [
      "Merlin::RenderWorld",
      "Merlin::RenderExtraction",
      "Merlin::RenderBackend"@_merlin_metadata_exported_vulkan@@_merlin_metadata_exported_metal@@_merlin_metadata_exported_materialx@
    ],
    "runtime_products_contract": "runtime-only",
    "runtime_products": @_merlin_metadata_runtime_products@
  }
}
