#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Asset"
{
    def ParticleField3DGaussianSplat "Splat"
    {
        half[] opacitiesh = [0.75]
        quath[] orientationsh = [(1, 0, 0, 0)]
        point3h[] positionsh = [(0, 0, 0)]
