schema = "openstrata.formation/v1alpha1"

[formation]
name = "merlin-gaussian-host-session"

# OpenUSD 26.08, Windows x86_64, cy2026 lookdev (OpenGL host).
[runtime]
artifact = "sha256:b982656c07dd9147973e3c7197d9b050ee48dd1ac291988f7e6025c76c4a785b"

[[components]]
id = "gaussian-ply"
kind = "plugin"
artifact = "@GAUSSIAN_PLY_ARTIFACT@"

[[components]]
id = "merlin"
kind = "renderer"
artifact = "@MERLIN_ARTIFACT@"

[command]
program = "testusdview"
args = ["sample.ply", "--defaultsettings", "--renderer", "Merlin", "--testScript", "gaussian_ply_check.py"]
