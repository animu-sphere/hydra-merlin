# Opt-in hardware validation: these fixtures require bindless GPU Scene and
# indirect-count support. They deliberately fail on an unsupported device.
if(NOT DEFINED MERLIN_BENCHMARK OR NOT DEFINED MERLIN_BENCHMARK_OUTPUT_DIR)
  message(FATAL_ERROR "requires benchmark executable and output directory")
endif()
file(MAKE_DIRECTORY "${MERLIN_BENCHMARK_OUTPUT_DIR}")
foreach(case gpu-driven-small-objects gpu-driven-diverse-objects
    gpu-driven-textured-objects arena-2 arena-4 arena-8 arena-16
    generated-material-objects)
  set(fixture "${case}")
  set(extra_arguments)
  set(expected_vertex_blocks 1)
  if(case MATCHES "^arena-([0-9]+)$")
    set(fixture gpu-driven-arena-objects)
    set(expected_vertex_blocks "${CMAKE_MATCH_1}")
    list(APPEND extra_arguments --arena-blocks "${expected_vertex_blocks}")
  endif()
  if(MERLIN_BENCHMARK_VALIDATE)
    list(APPEND extra_arguments --validate)
  endif()
  set(output "${MERLIN_BENCHMARK_OUTPUT_DIR}/${case}.json")
  execute_process(
    COMMAND "${MERLIN_BENCHMARK}" --fixture "${fixture}"
            --width 256 --height 256 --steady-frames 3 ${extra_arguments} --output "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 120
  )
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${fixture} failed (${result})\n${stdout}\n${stderr}")
  endif()
  file(READ "${output}" json)
  string(JSON schema GET "${json}" schema)
  string(JSON name GET "${json}" fixture name)
  string(JSON meshes GET "${json}" fixture mesh_count)
  string(JSON instances GET "${json}" fixture instance_count)
  string(JSON triangles GET "${json}" fixture triangle_count)
  string(JSON count LENGTH "${json}" baselines)
  if(NOT fixture STREQUAL "gpu-driven-small-objects")
    set(expected_meshes 16)
    set(expected_triangles 150000)
    set(minimum_batches 2)
    set(maximum_batches 128)
  else()
    set(expected_meshes 1)
    set(expected_triangles 100000)
    set(minimum_batches 1)
    set(maximum_batches 1)
  endif()
  if(NOT schema STREQUAL "merlin-benchmark/v3" OR NOT name STREQUAL fixture
      OR NOT meshes EQUAL expected_meshes OR NOT instances EQUAL 100000
      OR NOT triangles EQUAL expected_triangles OR NOT count EQUAL 12)
    message(FATAL_ERROR "${fixture}: incorrect report schema or scene totals")
  endif()
  string(JSON vertex_blocks GET "${json}" residency geometry vertex_arena blocks)
  string(JSON index_blocks GET "${json}" residency geometry index_arena blocks)
  if(NOT vertex_blocks EQUAL expected_vertex_blocks OR NOT index_blocks EQUAL 1)
    message(FATAL_ERROR "${case}: unexpected geometry arena block counts")
  endif()
  if(MERLIN_BENCHMARK_VALIDATE)
    string(JSON enabled GET "${json}" environment validation_enabled)
    string(JSON messages GET "${json}" environment validation_messages)
    if(NOT enabled OR NOT messages EQUAL 0)
      message(FATAL_ERROR "${case}: validation disabled or renderer diagnostics present")
    endif()
  endif()
  if(fixture STREQUAL "generated-material-objects")
    set(phases update conventional prefer-fallback camera-motion-prefer-fallback)
  else()
    set(phases update conventional gpu-driven camera-motion-gpu-driven)
  endif()
  string(JSON comparisons GET "${json}" mesh_verification exact_aov_comparisons)
  string(JSON rejections GET "${json}" mesh_verification required_submission_rejections)
  if(fixture STREQUAL "generated-material-objects")
    string(JSON parameters GET "${json}" mesh_verification generated_parameter_recovery)
    string(JSON modules GET "${json}" mesh_verification generated_module_recovery)
    string(JSON reason GET "${json}" mesh_verification required_rejection_reason)
    if(NOT comparisons EQUAL 6 OR NOT rejections EQUAL 3 OR NOT parameters OR NOT modules
        OR NOT reason MATCHES "persistent bindless GPU Scene state is unavailable")
      message(FATAL_ERROR "${case}: missing parity/rejection/edit recovery evidence")
    endif()
  elseif(fixture STREQUAL "gpu-driven-textured-objects" OR fixture STREQUAL "gpu-driven-arena-objects")
    if(NOT comparisons EQUAL 12 OR NOT rejections EQUAL 0)
      message(FATAL_ERROR "${case}: missing independent Forward parity evidence")
    endif()
  elseif(NOT comparisons EQUAL 6 OR NOT rejections EQUAL 0)
    message(FATAL_ERROR "${case}: missing GPU parity evidence")
  endif()
  set(index 0)
  foreach(draws 1000 10000 100000)
    foreach(phase IN LISTS phases)
      string(JSON name GET "${json}" baselines ${index} name)
      if(NOT name STREQUAL "${phase}-${draws}")
        message(FATAL_ERROR "unexpected baseline ${name} at ${index}")
      endif()
      if(NOT phase STREQUAL "update")
        foreach(counter upload_bytes allocation_count descriptor_update_count
            pipeline_creation_count mesh_cpu_draw_visit_count
            gpu_driven_candidate_upload_bytes)
          string(JSON value GET "${json}" baselines ${index} counters ${counter})
          if(NOT value EQUAL 0)
            message(FATAL_ERROR "${name}: ${counter} must be zero, got ${value}")
          endif()
        endforeach()
        string(JSON candidates GET "${json}" baselines ${index} counters
               gpu_driven_candidate_draw_count)
        string(JSON visible GET "${json}" baselines ${index} counters
               gpu_driven_visible_draw_count)
        string(JSON batches GET "${json}" baselines ${index} counters
               gpu_driven_indirect_draw_count)
        string(JSON samples GET "${json}" baselines ${index} samples)
        string(JSON fallback GET "${json}" baselines ${index} counters gpu_driven_fallback_count)
        string(JSON generated GET "${json}" baselines ${index} counters generated_material_draw_count)
        string(JSON material_fallback GET "${json}" baselines ${index} counters generated_material_fallback_count)
        if(NOT samples EQUAL 3 OR NOT material_fallback EQUAL 0)
          message(FATAL_ERROR "${name}: wrong sample count or material fallback")
        endif()
        if(fixture STREQUAL "generated-material-objects")
          if(phase STREQUAL "conventional")
            set(expected_fallback 0)
          else()
            set(expected_fallback 1)
          endif()
          if(NOT generated EQUAL draws OR NOT candidates EQUAL 0 OR NOT visible EQUAL 0
              OR NOT batches EQUAL 0 OR NOT fallback EQUAL expected_fallback)
            message(FATAL_ERROR "${name}: generated ABI/fallback contract failed")
          endif()
        elseif(phase STREQUAL "conventional")
          if(NOT candidates EQUAL 0 OR NOT batches EQUAL 0 OR NOT fallback EQUAL 0)
            message(FATAL_ERROR "${name}: conventional phase selected GPU execution")
          endif()
        elseif(NOT candidates EQUAL draws OR NOT visible EQUAL draws
            OR batches LESS minimum_batches OR batches GREATER maximum_batches
            OR NOT fallback EQUAL 0)
          message(FATAL_ERROR "${name}: incorrect GPU work")
        endif()
      endif()
      math(EXPR index "${index} + 1")
    endforeach()
  endforeach()
  message(STATUS "${case}: image parity and structural/schema checks passed")
endforeach()
