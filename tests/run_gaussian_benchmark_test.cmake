# Explicit hardware gate. Timing thresholds are deliberately absent.
if(NOT DEFINED MERLIN_BENCHMARK OR NOT DEFINED MERLIN_BENCHMARK_OUTPUT_DIR)
  message(FATAL_ERROR "requires benchmark executable and output directory")
endif()
if(NOT DEFINED MERLIN_GAUSSIAN_FIXTURES)
  set(MERLIN_GAUSSIAN_FIXTURES one-million-gaussians)
endif()
file(MAKE_DIRECTORY "${MERLIN_BENCHMARK_OUTPUT_DIR}")
set(extra)
if(MERLIN_BENCHMARK_VALIDATE)
  list(APPEND extra --validate)
endif()
foreach(fixture IN LISTS MERLIN_GAUSSIAN_FIXTURES)
  set(output "${MERLIN_BENCHMARK_OUTPUT_DIR}/${fixture}.json")
  execute_process(COMMAND "${MERLIN_BENCHMARK}" --fixture "${fixture}"
    --width 597 --height 540 --steady-frames 4 ${extra} --output "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 300)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${fixture} failed: ${stdout}\n${stderr}")
  endif()
  file(READ "${output}" json)
  string(JSON schema GET "${json}" schema)
  string(JSON count LENGTH "${json}" baselines)
  string(JSON comparisons LENGTH "${json}" gaussian_verification comparisons)
  if(NOT schema STREQUAL "merlin-benchmark/v3" OR NOT count EQUAL 8 OR NOT comparisons EQUAL 4)
    message(FATAL_ERROR "${fixture}: missing static/motion or image evidence")
  endif()
  foreach(comparison RANGE 0 3)
    string(JSON passed GET "${json}" gaussian_verification comparisons ${comparison} passed)
    if(NOT passed)
      message(FATAL_ERROR "${fixture}: Gaussian image tolerance exceeded")
    endif()
  endforeach()
  set(index 2)
  foreach(path cpu gpu-sorted-stream gpu-tiled)
    foreach(phase static camera-motion)
      string(JSON name GET "${json}" baselines ${index} name)
      string(JSON samples GET "${json}" baselines ${index} samples)
      if(NOT name STREQUAL "${phase}-${path}" OR NOT samples EQUAL 4)
        message(FATAL_ERROR "${fixture}: wrong phase/samples at ${index}")
      endif()
      if(NOT path STREQUAL "cpu")
        foreach(counter upload_bytes gaussian_upload_bytes gaussian_attribute_upload_bytes
            allocation_count pipeline_creation_count gaussian_gpu_preparation_fallback_count
            gaussian_gpu_sort_fallback_count gaussian_gpu_raster_fallback_count
            gaussian_gpu_tile_fallback_count gaussian_gpu_tile_raster_fallback_count
            gaussian_gpu_tile_raster_overflow_fallback_count)
          string(JSON value GET "${json}" baselines ${index} counters ${counter})
          if(NOT value EQUAL 0)
            message(FATAL_ERROR "${fixture}/${name}: ${counter} must be zero")
          endif()
        endforeach()
        string(JSON skipped GET "${json}" baselines ${index} counters gaussian_cpu_preparation_skipped_count)
        if(NOT skipped EQUAL 1)
          message(FATAL_ERROR "GPU Gaussian frame did not skip CPU preparation")
        endif()
      endif()
      foreach(stage gaussian_preparation gaussian_gpu_preparation gaussian_gpu_sort
          gaussian_gpu_tile gaussian_raster completion_wait readback gpu_execution total_frame)
        foreach(stat median p95 p99 max)
          string(JSON value GET "${json}" baselines ${index} stages_ns ${stage} ${stat})
          if(value LESS 0)
            message(FATAL_ERROR "negative stage time")
          endif()
        endforeach()
      endforeach()
      math(EXPR index "${index} + 1")
    endforeach()
  endforeach()
  if(MERLIN_BENCHMARK_VALIDATE)
    string(JSON enabled GET "${json}" environment validation_enabled)
    string(JSON messages GET "${json}" environment validation_messages)
    if(NOT enabled OR NOT messages EQUAL 0)
      message(FATAL_ERROR "${fixture}: validation not clean")
    endif()
  endif()
  message(STATUS "${fixture}: Gaussian static/motion/image/report contracts passed")
endforeach()
